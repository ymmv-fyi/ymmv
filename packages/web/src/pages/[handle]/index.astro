---
import { isValidHandle } from "@ymmv/shared";
import { env } from "cloudflare:workers";
import Layout from "../../components/Layout.astro";
import NotFound from "../../components/NotFound.astro";
import Profile from "../../components/Profile.astro";
import { readCacheControl, resolveProfile } from "../../lib/profile-read.ts";

// SSR profile page. Shares the resolver with the JSON endpoint, so HTML + JSON agree on
// live / renamed (301) / not-found. A D1 throw bubbles → Astro 500 (error honesty), never a fake 404.
const raw = String(Astro.params.handle ?? "");

// A native (script-failed) diff-form submit lands here as GET /<handle>?you=<x> — honor it
// server-side so the form still works when its inline script never ran: redirect to the canonical
// diff URL. Only a valid handle shape redirects (mirrors the form's own guard); anything else
// falls through and renders the profile. Runs before the D1 read — the redirect needs no data.
const you = (Astro.url.searchParams.get("you") ?? "").trim().replace(/^@+/, "");
if (you.length <= 39 && /^[a-zA-Z0-9](?:-?[a-zA-Z0-9])*$/.test(you)) {
  const redirect = Astro.redirect(`/${encodeURIComponent(raw)}/vs/${encodeURIComponent(you)}`, 302);
  // every response carries an explicit edge policy — keep the 302 short-cached like a notfound
  redirect.headers.set("cache-control", readCacheControl("notfound"));
  return redirect;
}

const result = await resolveProfile(env.DB, raw);

// Renamed away → 301 to the owner's current root URL, with the edge-cache policy attached.
if (result.kind === "renamed") {
  return new Response(null, {
    status: 301,
    headers: { location: `/${result.handle}`, "cache-control": readCacheControl("renamed") },
  });
}

Astro.response.headers.set("cache-control", readCacheControl(result.kind));
if (result.kind === "notfound") {
  Astro.response.status = 404;
}

// URL-as-title: the title IS the page's address — the same identity line the breadcrumb and the
// CLI print. Distinctive in tabs and link cards; the handle sits 9 characters in. Only a
// handle-SHAPED segment may wear the URL dress: arbitrary garbage in a URL-shaped title (bidi
// controls, deceptive words) borrows the domain's credibility, so it falls back to the bare brand.
const safeRaw = isValidHandle(raw) ? raw : null;
const title =
  result.kind === "live"
    ? `ymmv.fyi/${result.profile.handle}`
    : safeRaw
      ? `ymmv.fyi/${safeRaw}`
      : "ymmv.fyi";
const description =
  result.kind === "live"
    ? `${result.profile.handle}'s developer tool stack on ymmv.fyi.`
    : safeRaw
      ? `No ymmv profile for ${safeRaw} yet. Publish yours with npx ymmv-cli@latest.`
      : undefined;
// canonical: only a LIVE profile is canonical for anything, and only under its RESOLVED handle —
// alias spellings (case, encoding) must consolidate to it, and 404s carry no canonical at all.
const canonicalPath =
  result.kind === "live" ? `/${encodeURIComponent(result.profile.handle)}` : undefined;
---

<Layout title={title} description={description} canonicalPath={canonicalPath}>
  {result.kind === "live" ? <Profile profile={result.profile} /> : <NotFound handle={raw} />}
</Layout>
