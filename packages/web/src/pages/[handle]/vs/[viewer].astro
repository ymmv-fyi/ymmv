---
import { diff, type DiffResult, isValidHandle } from "@ymmv/shared";
import { env } from "cloudflare:workers";
import Arrow from "../../../components/Arrow.astro";
import Diff from "../../../components/Diff.astro";
import Layout from "../../../components/Layout.astro";
import NotFound from "../../../components/NotFound.astro";
import Profile from "../../../components/Profile.astro";
import { readCacheControl, resolveProfile } from "../../../lib/profile-read.ts";

// The web diff: /<handle>/vs/<viewer> — "how <handle> differs from <viewer>". Shareable; runs the
// shared diff(). theirs = the [handle] being viewed; mine = the [viewer] ("you").
const theirsRaw = String(Astro.params.handle ?? "");
const mineRaw = String(Astro.params.viewer ?? "");

const [theirs, mine] = await Promise.all([
  resolveProfile(env.DB, theirsRaw),
  resolveProfile(env.DB, mineRaw),
]);

// Keep the diff URL canonical: follow either side's rename to the current handle.
if (theirs.kind === "renamed") {
  return new Response(null, {
    status: 301,
    headers: {
      location: `/${theirs.handle}/vs/${encodeURIComponent(mineRaw)}`,
      "cache-control": readCacheControl("renamed"),
    },
  });
}
if (theirs.kind === "live" && mine.kind === "renamed") {
  return new Response(null, {
    status: 301,
    headers: {
      location: `/${theirs.profile.handle}/vs/${mine.handle}`,
      "cache-control": readCacheControl("renamed"),
    },
  });
}

// The long-lived policy needs BOTH sides live: the nudge state ("no profile for <you> yet")
// must stay short-cached like a 404, or a viewer who publishes right after seeing it can be
// served the stale nudge from the edge for the length of the stale window.
Astro.response.headers.set(
  "cache-control",
  readCacheControl(theirs.kind === "live" && mine.kind === "live" ? "live" : "notfound"),
);
if (theirs.kind !== "live") {
  Astro.response.status = 404;
}

const theirsProfile = theirs.kind === "live" ? theirs.profile : null;
const diffResult: DiffResult | null =
  theirs.kind === "live" && mine.kind === "live" ? diff(mine.profile, theirs.profile) : null;
const mineHandle = mine.kind === "live" ? mine.profile.handle : mineRaw;

// URL-as-title (matches the profile page): the diff and nudge states title as the /vs/ address
// being viewed; a 404'd [handle] falls back to that handle's root address (what NotFound is
// about). Only handle-SHAPED segments may wear the URL dress — the viewer segment is otherwise
// unvalidated and a garbage segment in a URL-shaped title borrows the domain's credibility
// (bidi controls, deceptive words), so invalid shapes fall back to shorter honest titles.
const mineSafe = mine.kind === "live" ? mine.profile.handle : isValidHandle(mineRaw) ? mineRaw : null;
const theirsSafe = isValidHandle(theirsRaw) ? theirsRaw : null;
const title = theirsProfile
  ? mineSafe
    ? `ymmv.fyi/${theirsProfile.handle}/vs/${mineSafe}`
    : `ymmv.fyi/${theirsProfile.handle}`
  : theirsSafe
    ? `ymmv.fyi/${theirsSafe}`
    : "ymmv.fyi";
// a diff-specific share description; the other states keep Layout's default
const description =
  theirsProfile && diffResult
    ? `How ${theirsProfile.handle}'s developer tool stack differs from ${mineHandle}'s. Your mileage may vary.`
    : undefined;
// Only a real two-sided diff is canonical for its RESOLVED /vs/ address. The 200-status nudge is
// a transient state: no canonical (junk viewer segments must not mint indexable URLs) + noindex.
const canonicalPath =
  theirsProfile && mine.kind === "live"
    ? `/${encodeURIComponent(theirsProfile.handle)}/vs/${encodeURIComponent(mine.profile.handle)}`
    : undefined;
const noindex = Boolean(theirsProfile && !diffResult);
---

<Layout title={title} description={description} canonicalPath={canonicalPath} noindex={noindex}>
  {
    !theirsProfile ? (
      <NotFound handle={theirsRaw} />
    ) : diffResult ? (
      <Diff result={diffResult} theirs={theirsProfile.handle} mine={mineHandle} />
    ) : (
      <>
        <Profile profile={theirsProfile} />
        {/* copy rule: no em dashes in user-facing prose — sentence break, capital opener */}
        <p class="nudge">No ymmv profile for <bdi>{mineRaw}</bdi> yet. Publish yours to diff <Arrow /></p>
      </>
    )
  }
</Layout>
