---
import { type Profile, SCHEMA_VERSION } from "@ymmv/shared";
import Arrow from "../components/Arrow.astro";
import InstallCommand from "../components/InstallCommand.astro";
import Layout from "../components/Layout.astro";
import ProfileExample from "../components/Profile.astro";
import TerminalRun from "../components/TerminalRun.astro";
import { readCacheControl } from "../lib/profile-read.ts";

// Landing (decided 2026-09-14 from the /proto/landing rounds, direction "House" — DESIGN.md →
// Landing layout): the solo pitch. What one developer gets today is one command that publishes
// their setup in about ten seconds, so the page shows exactly that — the claim, the install
// command, then the real run in a terminal window beside the page it produces. The diff needs
// other people, so it is a footnote. The profile sample is static (clearly labelled) so the
// landing always renders, independent of the DB.
const octocatProfile: Profile = {
  schema_version: SCHEMA_VERSION,
  handle: "octocat",
  entries: [
    { key: "editor", value: "Neovim" },
    { key: "os", value: "macOS 15.2" },
    { key: "shell", value: "fish" },
    { key: "prompt", value: "Starship" },
    { key: "terminal", value: "Ghostty" },
    { key: "browser", value: "Zen" },
    { key: "window-manager", value: "Aerospace" },
    { key: "font", value: "Berkeley Mono" },
    { key: "theme", value: "Catppuccin Mocha" },
    { key: "multiplexer", value: "tmux" },
    { key: "version-manager", value: "mise" },
    // dotfiles is a curated stack key — keep the example grouped exactly like a live profile
    { key: "dotfiles", value: "https://github.com/octocat/dotfiles" },
    { key: "ai-tool", value: "Claude Code" },
  ],
  extras: [{ label: "Keyboard", value: "HHKB Pro 2" }],
  updated_at: "2026-06-28T00:00:00.000Z",
};

// The page window is a PREVIEW, not the profile page reproduced: enough rows to show the shape
// (including the one amber dotfiles link), an honest "+ N more" for the rest.
const PREVIEW_KEYS = new Set(["editor", "os", "shell", "terminal", "font", "dotfiles", "ai-tool"]);
const octocatPreview: Profile = {
  ...octocatProfile,
  entries: octocatProfile.entries.filter((e) => PREVIEW_KEYS.has(e.key)),
  extras: [],
};
const previewMore =
  octocatProfile.entries.length - octocatPreview.entries.length + octocatProfile.extras.length;

// A real, live profile to bridge the fictional sample to the product (octocat is a mascot).
const LIVE_HANDLE = "bardisty";

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "ymmv",
  url: "https://ymmv.fyi",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS, Linux, Windows",
  description:
    "Terminal-native developer tool-stack profiles. Publish from the CLI, get a page at ymmv.fyi/you, diff against anyone.",
});

// The landing is request-invariant, but its HTML names hashed /_astro assets that a deploy
// replaces, so it takes the SHORT (notfound) policy: a long stale window could serve markup
// pointing at assets that no longer exist.
Astro.response.headers.set("cache-control", readCacheControl("notfound"));
---

<Layout title="ymmv.fyi: your stack, in the terminal" wide canonicalPath="/">
  <script type="application/ld+json" is:inline slot="head" set:html={jsonLd} />

  <header class="site-top">
    <a class="wordmark" href="/">ymmv<span class="dim">.fyi</span></a>
    <nav class="site-nav" aria-label="Site">
      <a href="https://github.com/ymmv-fyi/ymmv">source</a>
      <a href="https://github.com/ymmv-fyi/ymmv/blob/main/docs/api.md">api</a>
    </nav>
  </header>

  <section class="hero">
    <h1 class="claim">Your dev setup. Published in about ten seconds.</h1>
    <p class="vary">Your mileage may vary.</p>
    <div class="lede">
      <p class="tagline">
        One command detects your editor, shell, terminal and seven more, shows you what it
        found, and puts it at <code>ymmv.fyi/you</code>. Nothing publishes until you say so.
      </p>
      <div class="hero-cta">
        <InstallCommand />
        <p class="live-link">
          or see a live one <Arrow /> <a href={`/${LIVE_HANDLE}`}>ymmv.fyi/{LIVE_HANDLE}</a>
        </p>
      </div>
    </div>
  </section>

  {/* the run, and the page it makes. TerminalRun's script sets data-play here for the intro. */}
  <section class="demo" aria-label="What a run looks like" data-demo>
    <TerminalRun />
    <figure class="win page-win">
      <figcaption class="win-bar">
        <span class="win-url">ymmv.fyi/{octocatPreview.handle}</span>
      </figcaption>
      <div class="win-page">
        <ProfileExample profile={octocatPreview} example more={previewMore} />
      </div>
    </figure>
  </section>

  <section class="get">
    <h2 class="example-label">what you get</h2>
    <dl class="get-list">
      <div>
        <dt>Auto-detection</dt>
        <dd>
          Ten values read from your environment and pre-filled: OS, shell, prompt, terminal,
          editor, multiplexer, version manager, window manager, browser, AI tool. Font, theme
          and dotfiles you type in once.
        </dd>
      </div>
      <div>
        <dt>Nothing publishes until you confirm</dt>
        <dd>
          Detection only pre-fills. Press <code>e</code> to edit any value, <code>n</code> to
          walk away, <code>y</code> to publish. <code>ymmv delete</code> removes everything,
          any time.
        </dd>
      </div>
      <div>
        <dt>Updating is the same command</dt>
        <dd>
          Run it again after you switch editors. Or change one value:{" "}
          <code>ymmv set editor Neovim</code>. Add a line of your own:{" "}
          <code>ymmv set -e "Keyboard=HHKB"</code>.
        </dd>
      </div>
      <div>
        <dt>Your page is data too</dt>
        <dd>
          <code>GET ymmv.fyi/api/v1/u/you</code> returns the same stack as JSON, for a README
          badge or your own site.
        </dd>
      </div>
    </dl>
    <p class="get-note">Works on macOS, Linux, Windows and WSL. Node 22 or newer.</p>
  </section>

  <aside class="later">
    <p>
      <b>Later, when someone you know publishes theirs:</b>{" "}
      <code>npx ymmv-cli@latest {LIVE_HANDLE}</code> shows their stack in your terminal, and how it
      differs from yours once you're signed in. On the web,{" "}
      <code>ymmv.fyi/{LIVE_HANDLE}/vs/you</code>.
    </p>
  </aside>

  <footer class="site-foot">
    <p class="foot-h">Reference</p>
    <div class="fg">
      <span class="g">terminal</span>
      <div class="fl">
        <code>npx ymmv-cli@latest</code>
        <span class="n">publish your stack</span>
      </div>
      <div class="fl">
        <code>npx ymmv-cli@latest &lt;handle&gt;</code>
        <span class="n">view, or diff vs yours</span>
      </div>
    </div>
    <div class="fg">
      <span class="g">web</span>
      <div class="fl">
        <code>ymmv.fyi/&lt;handle&gt;</code>
        <span class="n">a profile</span>
      </div>
      <div class="fl">
        <code>ymmv.fyi/&lt;handle&gt;/vs/&lt;you&gt;</code>
        <span class="n">the diff</span>
      </div>
    </div>
    <div class="fg">
      <span class="g">data</span>
      <div class="fl">
        <code>GET /api/v1/u/&lt;handle&gt;</code>
        <span class="n"><a href="https://github.com/ymmv-fyi/ymmv/blob/main/docs/api.md">json, documented</a></span>
      </div>
    </div>
    <div class="fg">
      <span class="g">source</span>
      <div class="fl">
        <a href="https://github.com/ymmv-fyi/ymmv">github.com/ymmv-fyi/ymmv</a>
        <span class="n">code + issues</span>
      </div>
    </div>
  </footer>
</Layout>
