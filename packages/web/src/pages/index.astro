---
import { diff, type Profile, SCHEMA_VERSION } from "@ymmv/shared";
import Arrow from "../components/Arrow.astro";
import Diff from "../components/Diff.astro";
import InstallCommand from "../components/InstallCommand.astro";
import Layout from "../components/Layout.astro";
import ProfileExample from "../components/Profile.astro";
import TerminalRun from "../components/TerminalRun.astro";
import { readCacheControl } from "../lib/profile-read.ts";

// Landing (DESIGN.md → Landing; decided 2026-11-11 from the /proto/site run, the aurora-sky direction):
// the claim and the install command over the Borealis sky, then the product itself in one window
// (the real publish run beside the page it makes), how it works, a live-shaped diff, the API, and
// the brand's own line. The samples are static (clearly fictional mascots) so the landing always
// renders, independent of the DB.
const octocat: Profile = {
  schema_version: SCHEMA_VERSION,
  handle: "octocat",
  entries: [
    { key: "editor", value: "Neovim" },
    { key: "os", value: "macOS 15.2" },
    { key: "shell", value: "fish" },
    { key: "prompt", value: "Starship" },
    { key: "terminal", value: "Ghostty" },
    { key: "browser", value: "Zen" },
    { key: "window-manager", value: "Aerospace" },
    { key: "font", value: "Berkeley Mono" },
    { key: "theme", value: "Catppuccin Mocha" },
    { key: "multiplexer", value: "tmux" },
    { key: "version-manager", value: "mise" },
    // dotfiles is a curated stack key — keep the example grouped exactly like a live profile
    { key: "dotfiles", value: "https://github.com/octocat/dotfiles" },
    { key: "ai-tool", value: "Claude Code" },
  ],
  extras: [{ label: "Keyboard", value: "HHKB Pro 2" }],
  updated_at: "2026-06-28T00:00:00.000Z",
};

// The page pane is a PREVIEW, not the profile page reproduced: enough rows to show the shape
// (including the one dotfiles link), an honest "+ N more" for the rest.
const PREVIEW_KEYS = new Set(["editor", "os", "shell", "terminal", "font", "dotfiles", "ai-tool"]);
const octocatPreview: Profile = {
  ...octocat,
  entries: octocat.entries.filter((e) => PREVIEW_KEYS.has(e.key)),
  extras: [],
};
const previewMore = octocat.entries.length - octocatPreview.entries.length + octocat.extras.length;

// The compare sample: hubot (GitHub's other mascot) against octocat, through the real diff, so the
// panel shows exactly what a live /hubot/vs/octocat page would.
const hubot: Profile = {
  schema_version: SCHEMA_VERSION,
  handle: "hubot",
  entries: [
    { key: "editor", value: "Helix" },
    { key: "os", value: "macOS 15.2" },
    { key: "shell", value: "fish" },
    { key: "prompt", value: "Starship" },
    { key: "terminal", value: "WezTerm" },
    { key: "browser", value: "Firefox" },
    { key: "window-manager", value: "Aerospace" },
    { key: "font", value: "Berkeley Mono" },
    { key: "theme", value: "Tokyo Night" },
    { key: "multiplexer", value: "Zellij" },
    { key: "version-manager", value: "mise" },
    { key: "ai-tool", value: "Claude Code" },
  ],
  extras: [],
  updated_at: "2026-06-28T00:00:00.000Z",
};
const sampleDiff = diff(octocat, hubot);

// A real, live profile to bridge the fictional samples to the product.
const LIVE_HANDLE = "bardisty";
const CMD = "npx ymmv-cli@latest";
const API_DOCS = "https://github.com/ymmv-fyi/ymmv/blob/main/docs/api.md";

const DETECTED = [
  "OS",
  "Shell",
  "Prompt",
  "Terminal",
  "Editor",
  "Multiplexer",
  "Version manager",
  "Window manager",
  "Browser",
  "AI tool",
];

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "ymmv",
  url: "https://ymmv.fyi",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS, Linux, Windows",
  description:
    "Terminal-native developer tool-stack profiles. Publish from the CLI, get a page at ymmv.fyi/you, diff against anyone.",
});

// The landing is request-invariant, but its HTML names hashed /_astro assets that a deploy
// replaces, so it takes the SHORT (notfound) policy: a long stale window could serve markup
// pointing at assets that no longer exist.
Astro.response.headers.set("cache-control", readCacheControl("notfound"));
---

<Layout title="ymmv.fyi: your stack, in the terminal" wide navCommand canonicalPath="/">
  <script type="application/ld+json" is:inline slot="head" set:html={jsonLd} />

  {/* The sky: a CSS glow on the section, the Borealis canvas over it once WebGPU starts. */}
  <section class="hero">
    <canvas class="hero-canvas" aria-hidden="true"></canvas>
    <div class="hero-in">
      <div class="hero-copy" data-hero-copy>
        <h1 class="claim">Your dev setup, published in one command.</h1>
        <p class="sub">
          ymmv finds your editor, shell, terminal and seven more, shows you the list, and
          publishes it to <b>ymmv.fyi/you</b> when you say yes.
        </p>
        <div class="ctas" id="start">
          <InstallCommand tone="primary" />
          <p class="live-link">
            or see a live one <Arrow /> <a href={`/${LIVE_HANDLE}`}>ymmv.fyi/{LIVE_HANDLE}</a>
          </p>
        </div>
        <p class="fine">macOS, Linux, Windows and WSL. Node 22 or newer.</p>
      </div>
    </div>
  </section>

  {/* the run, and the page it makes. TerminalRun's script sets data-play here for the intro. */}
  <section class="shot demo" aria-label="A publish run and the page it makes" data-demo>
    <div class="window">
      <div class="window-bar">
        <span class="pane-label">Terminal</span>
        <span class="pane-label pane-label-page">ymmv.fyi/{octocatPreview.handle}</span>
      </div>
      <div class="window-body">
        <TerminalRun />
        <div class="page-pane">
          <ProfileExample profile={octocatPreview} example more={previewMore} />
        </div>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="how-h">
    <h2 class="h2" id="how-h">It asks before it publishes.</h2>
    <ul class="grid">
      <li class="cell">
        <h3 class="h3">Ten values, detected</h3>
        <p class="p">
          ymmv reads them from your environment. It can’t guess your font, theme or dotfiles, so you
          type those once.
        </p>
        <ul class="chips" aria-label="Detected values">
          {DETECTED.map((d) => <li>{d}</li>)}
        </ul>
      </li>
      <li class="cell">
        <h3 class="h3">Review the draft</h3>
        <p class="p">Detection only fills in a draft. You decide what happens to it.</p>
        <div class="keys">
          <span><kbd>e</kbd> edit a value</span>
          <span><kbd>n</kbd> walk away</span>
          <span><kbd>y</kbd> publish</span>
        </div>
      </li>
      <li class="cell">
        <h3 class="h3">Update with the same command</h3>
        <p class="p">
          Run it again after you switch editors. The preview marks each value your machine now
          detects differently, and <kbd>d</kbd> takes the ones you want.
        </p>
        <pre
          class="mini"><span class="t-a">~</span> Editor     <span class="t-dim">Neovim →</span> <span class="t-a">Helix</span>
<span class="t-a">+</span> Font       <span class="t-a">Berkeley Mono</span>
<span class="t-a">-</span> Theme      <span class="t-dim">Catppuccin Mocha</span></pre>
      </li>
      <li class="cell">
        <h3 class="h3">Yours to change or delete</h3>
        <p class="p">Change one value, add a line of your own, or delete your profile.</p>
        <pre
          class="mini"><span class="t-p">$ </span>ymmv set editor Neovim
<span class="t-p">$ </span>ymmv set -e "Keyboard=HHKB"
<span class="t-p">$ </span>ymmv delete</pre>
      </li>
    </ul>
  </section>

  <section class="sec split" aria-labelledby="cmp-h">
    <div class="sec-head">
      <h2 class="h2" id="cmp-h">See where your setups split.</h2>
      <p class="lead">
        When a friend publishes, one command lines your stacks up and highlights where they differ.
      </p>
      <dl class="cmd-ref">
        <div><dt>Terminal</dt><dd><code>{CMD} {LIVE_HANDLE}</code></dd></div>
        <div><dt>Web</dt><dd><code>ymmv.fyi/{LIVE_HANDLE}/vs/you</code></dd></div>
      </dl>
    </div>
    <div class="panel">
      <Diff result={sampleDiff} theirs="hubot" mine="octocat" example />
    </div>
  </section>

  <section class="sec split flip" aria-labelledby="api-h">
    <div class="sec-head">
      <h2 class="h2" id="api-h">Your page is JSON too.</h2>
      <p class="lead">
        Every profile is also a public JSON endpoint. Use it in a README badge or on your own site.
      </p>
      <a class="textlink" href={API_DOCS}>Read the API docs <Arrow /></a>
    </div>
    <pre
      class="panel code"><span class="t-p">$ </span>curl https://ymmv.fyi/api/v1/u/&lt;handle&gt;

{"{"}
  <span class="t-k">"schema_version"</span>: {SCHEMA_VERSION},
  <span class="t-k">"handle"</span>: "octocat",
  <span class="t-k">"entries"</span>: [
    {"{"} <span class="t-k">"key"</span>: "editor", <span class="t-k">"value"</span>: "Neovim" {"}"},
    {"{"} <span class="t-k">"key"</span>: "os", <span class="t-k">"value"</span>: "macOS 15.2" {"}"},
    {"{"} <span class="t-k">"key"</span>: "shell", <span class="t-k">"value"</span>: "fish" {"}"},
    <span class="t-dim">…</span>
  ],
  <span class="t-k">"extras"</span>: [{"{"} <span class="t-k">"label"</span>: "Keyboard", <span class="t-k">"value"</span>: "HHKB Pro 2" {"}"}],
  <span class="t-k">"updated_at"</span>: "2026-06-28T00:00:00.000Z"
{"}"}</pre>
  </section>

  <section class="end" aria-labelledby="end-h">
    <h2 class="end-h" id="end-h">Your mileage may vary.</h2>
    <p class="lead">Run it and see how your setup compares.</p>
    <InstallCommand tone="primary" size="lg" />
  </section>
</Layout>

<script>
  // The sky: only where WebGPU exists. The module (and its shaders) is a separate chunk, so a
  // browser without WebGPU never downloads it. Getting a GPU device takes about as long as the
  // download, so both start now and run side by side. Any failure leaves the CSS glow under the
  // canvas. No powerPreference: a hero background belongs on the battery-friendly GPU, and Chrome
  // on Windows ignores the hint with a console warning anyway.
  const canvas = document.querySelector<HTMLCanvasElement>(".hero-canvas");
  const copy = document.querySelector<HTMLElement>("[data-hero-copy]");
  if (canvas && copy && navigator.gpu) {
    const device = navigator.gpu.requestAdapter().then((adapter) => {
      if (!adapter) throw new Error("no WebGPU adapter");
      return adapter.requestDevice();
    });
    Promise.all([import("../gpu/aurora-hero.ts"), device])
      .then(([m, gpu]) => m.startAuroraHero(canvas, copy, gpu))
      .catch(() => canvas.remove());
  }

  // The nav carries the install command once the hero's own copy of it has scrolled away: one
  // primary action, always in reach, never shown twice.
  const nav = document.querySelector<HTMLElement>(".site-nav");
  const start = document.getElementById("start");
  if (nav && start) {
    new IntersectionObserver(
      ([entry]) => nav.toggleAttribute("data-cta-away", !(entry?.isIntersecting ?? true)),
      { rootMargin: "-64px 0px 0px 0px" },
    ).observe(start);
  }
</script>
