---
import { diff, type Profile, SCHEMA_VERSION } from "@ymmv/shared";
import Arrow from "../components/Arrow.astro";
import Diff from "../components/Diff.astro";
import InstallCommand from "../components/InstallCommand.astro";
import Layout from "../components/Layout.astro";
import ProfileExample from "../components/Profile.astro";

// Landing: the pitch + the one-line install, then the product shown as three numbered artifacts —
// 01 the CLI transcript, 02 the profile page, 03 the diff. Both profile/diff examples are static
// (clearly labelled) so the landing always renders, independent of the DB.
const octocatProfile: Profile = {
  schema_version: SCHEMA_VERSION,
  handle: "octocat",
  entries: [
    { key: "editor", value: "Neovim" },
    { key: "os", value: "macOS 15.2" },
    { key: "shell", value: "fish" },
    { key: "prompt", value: "Starship" },
    { key: "terminal", value: "Ghostty" },
    { key: "browser", value: "Zen" },
    { key: "window-manager", value: "Aerospace" },
    { key: "font", value: "Berkeley Mono" },
    { key: "theme", value: "Catppuccin Mocha" },
    { key: "multiplexer", value: "tmux" },
    { key: "version-manager", value: "mise" },
    // dotfiles is a curated stack key — keep the example grouped exactly like a live profile
    { key: "dotfiles", value: "https://github.com/octocat/dotfiles" },
    { key: "ai-tool", value: "Claude Code" },
  ],
  extras: [{ label: "Keyboard", value: "HHKB Pro 2" }],
  updated_at: "2026-06-28T00:00:00.000Z",
};

// The 02 sample is a PREVIEW, not the profile page reproduced: enough rows to show the shape
// (including the one amber dotfiles link), an honest "+ N more" for the rest. The diff below shows
// in full — it is the product. DESIGN.md "Landing layout".
const PREVIEW_KEYS = new Set(["editor", "os", "shell", "terminal", "font", "dotfiles", "ai-tool"]);
const octocatPreview: Profile = {
  ...octocatProfile,
  entries: octocatProfile.entries.filter((e) => PREVIEW_KEYS.has(e.key)),
  extras: [],
};
const previewMore =
  octocatProfile.entries.length - octocatPreview.entries.length + octocatProfile.extras.length;

// A second static persona to diff octocat against — GitHub's other mascot, so the pairing reads as
// illustrative, not a real user. Tuned to 7 differ / 6 shared: it keeps the mac-terminal core (os,
// prompt, terminal, window-manager, theme, multiplexer) and diverges on editor/shell/browser/font/
// version-manager/ai-tool, omitting dotfiles — so all three diff states show (changed, same, and a
// missing "—" row). octocat is reused verbatim, so the reader already knows the left column.
const hubotProfile: Profile = {
  schema_version: SCHEMA_VERSION,
  handle: "hubot",
  entries: [
    { key: "editor", value: "VS Code" },
    { key: "os", value: "macOS 15.2" },
    { key: "shell", value: "zsh" },
    { key: "prompt", value: "Starship" },
    { key: "terminal", value: "Ghostty" },
    { key: "browser", value: "Arc" },
    { key: "window-manager", value: "Aerospace" },
    { key: "font", value: "JetBrains Mono" },
    { key: "theme", value: "Catppuccin Mocha" },
    { key: "multiplexer", value: "tmux" },
    { key: "version-manager", value: "asdf" },
    { key: "ai-tool", value: "Copilot" },
  ],
  extras: [],
  updated_at: "2026-06-28T00:00:00.000Z",
};

// diff(mine, theirs): mine=hubot, theirs=octocat → octocat renders in the LEFT value column (under
// the profile example above it), hubot on the right. Computed in the frontmatter at render time
// (output:"server" renders this page per request); the engine is DB-free, so the landing always
// renders. Making the landing prerendered is a possible follow-up, not assumed here.
const exampleDiff = diff(hubotProfile, octocatProfile);

// A real, live profile to bridge the fictional samples to the product (octocat/hubot are mascots).
const LIVE_HANDLE = "bardisty";

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "ymmv",
  url: "https://ymmv.fyi",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS, Linux, Windows",
  description:
    "Terminal-native developer tool-stack profiles. Publish from the CLI, get a page at ymmv.fyi/you, diff against anyone.",
});
---

<Layout title="ymmv.fyi: your stack, in the terminal" wide canonicalPath="/">
  <script type="application/ld+json" is:inline slot="head" set:html={jsonLd} />
  <section class="hero">
    {
      /* The divergence field: parallel roads, an amber fork — the diff, drawn. The SVG is the
        no-JS / reduced-motion / forced-colors render; divergence.ts swaps in the canvas only
        when motion is allowed. Decorative, so the whole figure is aria-hidden. */
    }
    <div class="field" data-divergence aria-hidden="true">
      <svg
        class="field-static"
        viewBox="0 0 800 320"
        preserveAspectRatio="xMidYMid slice"
        fill="none"
      >
        {
          [20, 50, 80, 110, 140, 170, 200, 230, 260, 290].map((y) => (
            <line
              x1="0"
              y1={y}
              x2="800"
              y2={y}
              stroke="currentColor"
              stroke-width="1"
            />
          ))
        }
        <path
          d="M 300 170 L 430 140 L 800 140"
          stroke="var(--accent)"
          stroke-width="1"></path>
        <circle cx="300" cy="170" r="2.5" fill="var(--accent)"></circle>
      </svg>
      <canvas></canvas>
    </div>
    <div class="hero-copy">
      <h1 class="wordmark">ymmv<span class="dim">.fyi</span></h1>
      <p class="vary">Your mileage may vary.</p>
      <p class="tagline">
        <span class="lead">The tools you actually use</span>, at <code
          >ymmv.fyi/you</code
        >.<br />
        Publish from the CLI. Diff against anyone.
      </p>
      <InstallCommand />
      <p class="live-link">
        or see a live one <Arrow /> <a href={`/${LIVE_HANDLE}`}>ymmv.fyi/{LIVE_HANDLE}</a>
      </p>
    </div>
  </section>

  <section class="artifact artifact-term">
    <h2 class="example-label"><span class="idx">01</span> run it</h2>
    {
      /* A static transcript of the real publish flow (detect -> confirm -> published URL). Copy
        mirrors the CLI's actual output (packages/cli/src/render.ts + commands.ts — CLI parity);
        amber marks exactly what the CLI renders amber: the published link. Lines after the first
        sit flush-left in source because <pre> keeps authored whitespace. */
    }
    <div class="sample">
      <pre class="term"><span class="t-p">$ </span>npx ymmv-cli@latest

<span class="t-dim">  Editor    </span>Neovim
<span class="t-dim">  Shell     </span>fish
<span class="t-dim">  Terminal  </span>Ghostty
<span class="t-dim">  …</span>

<span class="t-dim">  Publish to ymmv.fyi/octocat? [Y/n/e=edit]</span> y

  Published octocat → <span class="t-link">ymmv.fyi/octocat</span></pre>
    </div>
  </section>

  <div class="artifacts">
    <section class="artifact artifact-profile">
      <h2 class="example-label"><span class="idx">02</span> your stack becomes a page</h2>
      <div class="sample">
        <ProfileExample profile={octocatPreview} example more={previewMore} />
      </div>
    </section>
    <section class="artifact artifact-diff">
      <h2 class="example-label"><span class="idx">03</span> diff against anyone</h2>
      <div class="sample">
        <Diff result={exampleDiff} theirs="octocat" mine="hubot" example />
      </div>
    </section>
  </div>

  <footer class="site-foot">
    <p class="foot-h">Reference</p>
    <div class="fg">
      <span class="g">terminal</span>
      <div class="fl">
        <code>npx ymmv-cli@latest</code>
        <span class="n">publish your stack</span>
      </div>
      <div class="fl">
        <code>npx ymmv-cli@latest &lt;handle&gt;</code>
        <span class="n">view, or diff vs yours</span>
      </div>
    </div>
    <div class="fg">
      <span class="g">web</span>
      <div class="fl">
        <code>ymmv.fyi/&lt;handle&gt;</code>
        <span class="n">a profile</span>
      </div>
      <div class="fl">
        <code>ymmv.fyi/&lt;handle&gt;/vs/&lt;you&gt;</code>
        <span class="n">the diff</span>
      </div>
    </div>
    <div class="fg">
      <span class="g">data</span>
      <div class="fl">
        <code>GET /api/v1/u/&lt;handle&gt;</code>
        <span class="n"><a href="https://github.com/ymmv-fyi/ymmv/blob/main/docs/api.md">json, documented</a></span>
      </div>
    </div>
    <div class="fg">
      <span class="g">source</span>
      <div class="fl">
        <a href="https://github.com/ymmv-fyi/ymmv">github.com/ymmv-fyi/ymmv</a>
        <span class="n">code + issues</span>
      </div>
    </div>
  </footer>
</Layout>

<script>
  import "../scripts/divergence.ts";
</script>
