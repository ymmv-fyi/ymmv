---
// The diff (DESIGN.md → Pages → Diff; decided 2026-11-12 from /proto/diff, direction "Ledger"):
// the profile's compared table, grown into its own page. Same columns, dot and counts line as the
// profile's inline compare, so a visitor who compared in place lands somewhere familiar, and one who
// opened a shared link sees the same shape every profile page uses. Rows keep the taxonomy order,
// as on the profile and in the CLI.
// The accent is scarce: it marks ONLY a real difference (both differing values + the label dot).
// A difference is symmetric, neither side is the "wrong" one. Same rows recede. A row only one
// side filled in is not a different tool: a grey dot, its value faint, counted as
// `N only <handle>` apart from `N differ` (the CLI's `?` row, same counts, same order).
// Values are user-controlled: compared cells go through lib/diff-cells.ts (shortening, collide
// guard, bidi stripping, a URL's slash break points) under Astro auto-escaping; extras labels
// through lib/sanitize.ts and extras values through UntrustedValue.
//
// a11y: the difference is conveyed without relying on color (WCAG 1.4.1). The label dot shows
// only on differing and one-sided rows (presence, not just hue), and each row carries a
// visually-hidden "differs:"/"same:"/"only <handle>:" prefix. Header and row-label cells are real
// <th>, the table is named by the h1, and a missing value reads "not set", not "dash".
//
// `example`: the landing-page sample diff (not a live /vs/ page). Like Profile.astro's `example`,
// it downgrades the <h1> to <p>, renders the handles as plain text (no navigation), and drops the
// command, the swap link and the extras.
import type { DiffResult } from "@ymmv/shared";
import { pairCells } from "../lib/diff-cells.ts";
import { sanitizeText } from "../lib/sanitize.ts";
import Arrow from "./Arrow.astro";
import InstallCommand from "./InstallCommand.astro";
import UntrustedValue from "./UntrustedValue.astro";

interface Props {
  result: DiffResult;
  theirs: string; // the profile being viewed (the [handle])
  mine: string; // the viewer ("you")
  example?: boolean; // landing sample: plain-text handles, no command, swap or extras
}
const { result, theirs, mine, example = false } = Astro.props;
const HeadingTag = example ? "p" : "h1";
// ids are per page: the landing renders one example, a /vs/ page one live diff
const headingId = example ? "diff-example-h" : "diff-h";
// Per row: its class and the screen-reader prefix.
const kind = (status: DiffResult["rows"][number]["status"]) =>
  status === "same"
    ? { cls: "s", sr: "same: " }
    : status === "changed"
      ? { cls: "d", sr: "differs: " }
      : { cls: "o", sr: `only ${status === "only_theirs" ? theirs : mine}: ` };
// The CLI spelling of this exact page: `ymmv <a> vs <b>` compares { theirs: a, mine: b }
// (cli resolve.ts versusTail), the same direction as /<a>/vs/<b>, so theirs stays first. Both
// sides are stored handles (Diff renders only when both profiles are live), never a raw URL
// segment, and a GitHub-shaped handle needs no shell quoting.
const command = `npx ymmv-cli@latest ${theirs} vs ${mine}`;
const counts: string[] = [`${result.differ} differ`, `${result.shared} shared`];
if (result.onlyTheirs > 0) counts.push(`${result.onlyTheirs} only ${theirs}`);
if (result.onlyMine > 0) counts.push(`${result.onlyMine} only ${mine}`);
// extras sit under the table, grouped by owner: inside it they'd read as one-sided compared rows
const extras = example
  ? []
  : [
      { who: theirs, rows: result.extras.theirs },
      { who: mine, rows: result.extras.mine },
    ].filter((g) => g.rows.length > 0);
---

<div class:list={["diff-page", example && "is-example"]}>
  <HeadingTag class="diff-h" id={headingId}>
    how <b>{example ? theirs : <a href={`/${encodeURIComponent(theirs)}`}>{theirs}</a>}</b> differs from{" "}
    <b>{example ? mine : <a href={`/${encodeURIComponent(mine)}`}>{mine}</a>}</b>
  </HeadingTag>

  {/* the command that produced this comparison, right under the heading: a copy control */}
  {!example && (
    <div class="diff-cmd">
      <InstallCommand command={command} />
    </div>
  )}

  {
    result.rows.length === 0 ? (
      <p class="diff-empty">
        Neither {theirs} nor {mine} has published a stack yet, so there’s nothing to compare.
      </p>
    ) : (
      <>
        {/* counts read left, the swap link sits right; whitespace separates, never punctuation */}
        <div class="diff-counts">
          {counts.map((c) => {
            const [n, ...rest] = c.split(" ");
            return (
              <span>
                <b>{n}</b> {rest.join(" ")}
              </span>
            );
          })}
          {!example && (
            <a href={`/${encodeURIComponent(mine)}/vs/${encodeURIComponent(theirs)}`}>
              Swap sides
              <Arrow />
            </a>
          )}
        </div>

        <table class="diff" aria-labelledby={headingId}>
          <thead>
            <tr>
              <th scope="col">
                <span class="sr-only">Key</span>
              </th>
              <th scope="col" title={theirs}>
                {theirs}
              </th>
              <th scope="col" title={mine}>
                {mine}
              </th>
            </tr>
          </thead>
          <tbody>
            {result.rows.map((row) => {
              const k = kind(row.status);
              // Never display a marked difference as two equal-looking strings: pairCells drops the
              // shortening, or marks invisible code points, whenever the two cells of a differing
              // row would otherwise show the same text (lib/diff-cells.ts).
              const cells = pairCells(row.theirs, row.mine, row.status !== "same");
              return (
                <tr class={k.cls}>
                  <th scope="row" class="diff-k">
                    <span class="diff-dot" aria-hidden="true" />
                    <span class="sr-only">{k.sr}</span>
                    {row.label}
                  </th>
                  {/* A URL cell comes cut after its slashes, and the <wbr> between the pieces lets a
                      narrow column wrap it between path segments. Every other cell is one piece. */}
                  {cells.map((c, i) => (
                    <td class={i === 0 ? "diff-v theirs" : "diff-v mine"}>
                      {c ? (
                        <span title={c.title}>
                          {c.segments.map((part, i) => (
                            <>
                              {i > 0 && <wbr />}
                              {part}
                            </>
                          ))}
                        </span>
                      ) : (
                        <>
                          <span class="diff-missing" aria-hidden="true">
                            —
                          </span>
                          <span class="sr-only">not set</span>
                        </>
                      )}
                    </td>
                  ))}
                </tr>
              );
            })}
          </tbody>
        </table>
      </>
    )
  }

  {
    extras.length > 0 && (
      <section class="diff-extras" aria-labelledby="diff-extras-h">
        <h2 class="diff-extras-h" id="diff-extras-h">
          Extras
        </h2>
        <p class="diff-extras-note">Lines added by hand. A diff doesn’t compare them.</p>
        {/* Same value treatment as the profile page (UntrustedValue: safeHref link + full-URL title +
            bidi stripping). <bdi> isolates each run so a genuinely RTL label or value can't reorder
            its neighbours. breakAfterSlash lets a link wrap between path segments. */}
        {extras.map((g) => (
          <div class="diff-x">
            <h3 class="diff-x-who">{g.who}</h3>
            <dl>
              {g.rows.map((x) => (
                <div class="diff-x-row">
                  <dt>
                    <bdi>{sanitizeText(x.label)}</bdi>
                  </dt>
                  <dd>
                    <UntrustedValue value={x.value} bdi breakAfterSlash />
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        ))}
      </section>
    )
  }
</div>
