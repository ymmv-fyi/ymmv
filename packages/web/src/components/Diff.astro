---
// The diff as a terminal session ("Session", decided 2026-08-24 from the /proto/diff prototype
// run — see DESIGN.md → Components & States): the same voice as the profile page. The command
// that produced the comparison opens the page (also the copy control), the readout keeps real
// <table> bones restyled to the bare session register, the ratio minimap speaks the CLI's
// no-color vocabulary (~/=), and extras render dimmed below.
// Amber is scarce: it marks ONLY a real difference (both differing values + the label dot) —
// a difference is symmetric, neither side is the "wrong" one. Same rows recede to --faint.
// Values are user-controlled → rendered via Astro auto-escaping and bidi-control stripping
// (lib/sanitize.ts); extras go through UntrustedValue.
//
// a11y: the difference is conveyed without relying on color (WCAG 1.4.1) — the label dot is shown
// only on differing rows (presence, not just hue), and each row carries a visually-hidden
// "differs:"/"same:" prefix for screen readers. Header + row-label cells are real <th>.
//
// `example`: the landing-page sample diff (not a live /vs/ page). Like Profile.astro's `example`,
// it downgrades the <h1> to <p>, renders the typed command as a plain line (no copy control) and
// the handles/swap as plain text (no navigation, no 2nd <h1>), and it suppresses the
// uncompared-extras block. A live diff passes no `example`.
import type { DiffResult } from "@ymmv/shared";
import { displayUrl, urlTitle } from "../lib/display-value.ts";
import { sanitizeText } from "../lib/sanitize.ts";
import Arrow from "./Arrow.astro";
import InstallCommand from "./InstallCommand.astro";
import UntrustedValue from "./UntrustedValue.astro";

interface Props {
  result: DiffResult;
  theirs: string; // the profile being viewed (the [handle])
  mine: string; // the viewer ("you")
  example?: boolean; // landing sample: plain-text handles, no swap, no extras
}
const { result, theirs, mine, example = false } = Astro.props;
const hasExtras = result.extras.theirs.length > 0 || result.extras.mine.length > 0;
const HeadingTag = example ? "p" : "h1";
---

<div class="session">
  {/* the command that produced this comparison — on live pages it is also the copy control */}
  <p class="cmdline">
    {example ? (
      <><span class="prompt">$ </span><b>npx ymmv-cli@latest {theirs}</b></>
    ) : (
      <InstallCommand command={`npx ymmv-cli@latest ${theirs}`} />
    )}
  </p>

  <HeadingTag class="url diff-h">
    <svg class="fork" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
      <path d="M1 9.5h12M4.5 9.5 8 4.5h5" stroke="currentColor" stroke-width="1.2" />
    </svg>
    how <b>{example ? theirs : <a href={`/${encodeURIComponent(theirs)}`}>{theirs}</a>}</b> differs from{" "}
    <b>{example ? mine : <a href={`/${encodeURIComponent(mine)}`}>{mine}</a>}</b>
  </HeadingTag>

  <table class="diff">
    <thead>
      <tr>
        <td></td>
        <th scope="col" title={theirs}>{theirs}</th>
        <th scope="col" title={mine}>{mine}</th>
      </tr>
    </thead>
    <tbody>
      {
        result.rows.map((row) => {
          const differs = row.status !== "same";
          // Never display a marked difference as two equal-looking strings: if dropping "https://"
          // would collide the sides (https://x vs x — dotfiles compares verbatim), render both raw;
          // if the sides differ only by bidi controls, stripping would collide them too, so mark
          // each control visibly (U+FFFD) instead of deleting it.
          const shortenCollide =
            row.theirs != null &&
            row.mine != null &&
            row.theirs !== row.mine &&
            displayUrl(row.theirs) === displayUrl(row.mine);
          const base = (v: string) => (shortenCollide ? v : displayUrl(v));
          const bidiCollide =
            row.theirs != null &&
            row.mine != null &&
            row.theirs !== row.mine &&
            sanitizeText(base(row.theirs)) === sanitizeText(base(row.mine));
          const cell = (v: string) => sanitizeText(base(v), { mark: bidiCollide });
          const cellTitle = (v: string) => {
            const full = shortenCollide ? undefined : urlTitle(v);
            return full && sanitizeText(full);
          };
          return (
            <tr class={differs ? "changed" : "same"}>
              <th scope="row" class="k">
                <span class="dot" aria-hidden="true" />
                <span class="sr-only">{differs ? "differs: " : "same: "}</span>
                {row.label}
              </th>
              <td class="theirs">
                {row.theirs != null ? (
                  <span title={cellTitle(row.theirs)}>{cell(row.theirs)}</span>
                ) : (
                  <span class="missing">—</span>
                )}
              </td>
              <td class="yours">
                {row.mine != null ? (
                  <span title={cellTitle(row.mine)}>{cell(row.mine)}</span>
                ) : (
                  <span class="missing">—</span>
                )}
              </td>
            </tr>
          );
        })
      }
    </tbody>
  </table>

  <div class="foot diff-foot">
    {/* the ratio minimap: one glyph per row, in row order, the CLI's no-color vocabulary —
        amber ~ where the stacks split, faint = where they share. Pure decoration over the counts
        beside it — no anchors (the e2e foot pins assume the swap link is the only <a> here). */}
    <span class="diff-map" aria-hidden="true">
      {result.rows.map((row) => (
        <i class={row.status === "same" ? "s" : "d"}>{row.status === "same" ? "=" : "~"}</i>
      ))}
    </span>
    <span><b>{result.differ}</b> differ</span>
    <span><b>{result.shared}</b> shared</span>
    {
      !example && (
        <a href={`/${encodeURIComponent(mine)}/vs/${encodeURIComponent(theirs)}`}>swap <Arrow /></a>
      )
    }
  </div>

  {
    !example && hasExtras && (
      <>
        <h2 class="x-h">extras (not compared)</h2>
        {/* Same value treatment as the profile page (UntrustedValue: safeHref link + full-URL
            title + bidi stripping). <bdi> isolates each run so a genuinely RTL label or value
            still can't visually reorder the "label = value" line. */}
        <table class="extras-dim">
          <tbody>
            {result.extras.theirs.map((x) => (
              <tr>
                <th scope="row" class="k">{theirs}</th>
                <td class="v">
                  <bdi>{sanitizeText(x.label)}</bdi> = <UntrustedValue value={x.value} bdi />
                </td>
              </tr>
            ))}
            {result.extras.mine.map((x) => (
              <tr>
                <th scope="row" class="k">{mine}</th>
                <td class="v">
                  <bdi>{sanitizeText(x.label)}</bdi> = <UntrustedValue value={x.value} bdi />
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </>
    )
  }
</div>
