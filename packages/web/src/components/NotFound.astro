---
// Empty / 404 state (DESIGN.md → Pages → Empty and 404): friendly "no ymmv profile for <handle>"
// + the one-line install. With no handle it's a generic 404.
// `handle` is the raw (unresolved) URL segment — user-controlled, so it renders auto-escaped and
// with bidi controls stripped. A segment made only of controls has nothing left to name, so it
// takes the generic branch. A reserved segment (/login, /api) is not a person either: its page
// passes no handle, so it renders the generic branch too.
import { sanitizeText } from "../lib/sanitize.ts";
import InstallCommand from "./InstallCommand.astro";

interface Props {
  handle?: string;
}
const { handle } = Astro.props;
const shown = handle ? sanitizeText(handle) : "";
---

<div class="empty">
  {
    shown ? (
      <>
        <h1 class="handle">{shown}</h1>
        <p class="empty-msg">
          no ymmv profile for <span class="h">{shown}</span> yet.
        </p>
      </>
    ) : (
      <>
        <h1 class="handle">404</h1>
        <p class="empty-msg">no page here.</p>
      </>
    )
  }
  <InstallCommand />
</div>
