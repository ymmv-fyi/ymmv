---
// The page shell (DESIGN.md → Aurora): head, the site stylesheet, self-hosted fonts, the site nav
// and footer. Every page renders inside this. Dark only: there is no theme toggle. User-controlled
// text is passed through Astro's auto-escaping {expression} interpolation — NEVER set:html on a
// profile field.
import { Font } from "astro:assets";
import "../styles/aurora.css";
import InstallCommand from "./InstallCommand.astro";

interface Props {
  title: string;
  description?: string;
  /* wide: the landing's full-bleed sections. Reading pages (profile/diff/privacy/404) sit in the
     760px column. */
  wide?: boolean;
  /* navCommand: the nav carries the install command, shown once the hero's own copy of it has
     scrolled away (the landing's script sets data-cta-away). */
  navCommand?: boolean;
  /* canonicalPath: the RESOLVED path this page is canonical for ("/", "/<handle>", …). Pages
     must pass it explicitly — deriving it from Astro.url.pathname let every alias spelling
     (/OctoCat, trailing slash, percent-encoding) self-canonicalize, and a crafted //host path
     resolves cross-origin against Astro.site. No prop → no canonical (correct for 404/nudge). */
  canonicalPath?: string;
  /* noindex: 200-status transient states (the /vs/ nudge) that must never be indexed. */
  noindex?: boolean;
}
const {
  title,
  description = "Terminal-native developer tool-stack profiles. Your mileage may vary.",
  wide = false,
  navCommand = false,
  canonicalPath,
  noindex = false,
} = Astro.props;
const REPO = "https://github.com/ymmv-fyi/ymmv";
const API_DOCS = `${REPO}/blob/main/docs/api.md`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="darkreader-lock" />
    {/* Browser-UI color (mobile toolbar/overscroll) = --bg in aurora.css. */}
    <meta name="theme-color" content="#050607" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* Absolute via Astro.site (like og:image) — Astro.url.origin would bake localhost/www
        variants per request. Query strings (e.g. /<handle>?you=) never belong in the canonical. */}
    {canonicalPath !== undefined && (
      <link rel="canonical" href={new URL(canonicalPath, Astro.site)} />
    )}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* Fonts via Astro's Fonts API: each <Font> injects the inlined @font-face + size-matched
        fallback + a preload for its latin file (latin-ext stays on demand via unicode-range).
        Exactly 2 preloads total (e2e-pinned). */}
    <Font cssVariable="--font-sans" preload={[{ subset: "latin" }]} />
    <Font cssVariable="--font-mono" preload={[{ subset: "latin" }]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {/* static brand card. og:image must be absolute — Astro.site, never Astro.url.origin (that
        would bake localhost/www variants per request). */}
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ymmv.fyi. Your dev setup, published in one command." />
    <meta name="twitter:card" content="summary_large_image" />
    {/* page-specific head extras (e.g. the landing's JSON-LD) */}
    <slot name="head" />
  </head>
  <body>
    <div class="nav-sentinel" aria-hidden="true"></div>
    <header class="site-nav">
      <div class="nav-in">
        <a class="logo" href="/"><span class="logo-mark" aria-hidden="true"></span>ymmv</a>
        <nav class="nav-links" aria-label="Site">
          <a href={API_DOCS}>API docs</a>
          <a href="/privacy">Privacy</a>
        </nav>
        <div class="nav-r">
          <a class="nav-icon" href={REPO} aria-label="ymmv on GitHub">
            <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"
              ><path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
              ></path></svg
            >
          </a>
          {navCommand && (
            <div class="nav-cmd">
              <InstallCommand tone="primary" size="sm" />
            </div>
          )}
        </div>
      </div>
    </header>
    <main class:list={["page", wide && "page-wide"]}>
      <slot />
    </main>
    <footer class="site-foot">
      <a class="logo" href="/"><span class="logo-mark" aria-hidden="true"></span>ymmv</a>
      <nav class="foot-links" aria-label="Footer">
        <a href={API_DOCS}>API docs</a>
        <a href={REPO}>Source</a>
        <a href={`${REPO}/issues`}>Issues</a>
        <a href="https://www.npmjs.com/package/ymmv-cli">npm</a>
        <a href={`${REPO}/blob/main/CHANGELOG.md`}>Changelog</a>
        <a href="/privacy">Privacy</a>
      </nav>
    </footer>
    {/* The nav takes its backdrop once content scrolls under it: a sentinel at the top of the
        page, watched, instead of a scroll handler. */}
    <script is:inline>
      (function () {
        var nav = document.querySelector(".site-nav");
        var sentinel = document.querySelector(".nav-sentinel");
        if (!nav || !sentinel || !("IntersectionObserver" in window)) return;
        new IntersectionObserver(function (entries) {
          nav.toggleAttribute("data-scrolled", !entries[0].isIntersecting);
        }).observe(sentinel);
      })();
    </script>
    {/* Click-to-copy for every command block: the landing's install CTA, the profile's view
        command and the diff's compare command. Progressive enhancement: only wires up (and reveals
        the copy affordance) when the Clipboard API is available; otherwise the command stays
        plain readable/selectable text. One delegated handler covers every [data-copy] block. */}
    <script is:inline>
      (function () {
        if (!navigator.clipboard) return;
        var RESET_MS = 1500; // one value for both the copied-state and failure-status resets
        var nodes = document.querySelectorAll("[data-copy]");
        nodes.forEach(function (el) {
          // Promote the plain span to an ARIA button now that copying actually works, so a
          // keyboard/AT user only reaches an operable control when the clipboard path is live
          // (no dead button with JS off). The action wording in the label is required a11y copy.
          // "command", not "install command": the profile and diff commands install nothing.
          el.setAttribute("role", "button");
          el.setAttribute("tabindex", "0");
          el.setAttribute("aria-label", "Copy command: " + el.dataset.copy);
          el.dataset.copyReady = "";
          var status = el.querySelector("[data-copy-status]");
          var timer;
          function copy() {
            navigator.clipboard
              .writeText(el.dataset.copy)
              .then(function () {
                el.dataset.copied = "";
                if (status) status.textContent = "Copied";
                clearTimeout(timer);
                timer = setTimeout(function () {
                  delete el.dataset.copied;
                  if (status) status.textContent = "";
                }, RESET_MS);
              })
              .catch(function () {
                // Clipboard blocked by policy (NotAllowedError): announce the failure instead of
                // an operable control that silently does nothing. No data-copied, so the glyph
                // never fakes success.
                if (status) status.textContent = "Copy failed";
                clearTimeout(timer);
                timer = setTimeout(function () {
                  if (status) status.textContent = "";
                }, RESET_MS);
              });
          }
          el.addEventListener("click", copy);
          el.addEventListener("keydown", function (ev) {
            // Enter and Space activate a button. preventDefault on Space so it copies instead of
            // scrolling the page. data-pressed mirrors :active for keyboard presses (a role=button
            // span never enters :active from the keyboard).
            if (ev.key === "Enter" || ev.key === " ") {
              ev.preventDefault();
              el.dataset.pressed = "";
              copy();
            }
          });
          el.addEventListener("keyup", function (ev) {
            if (ev.key === "Enter" || ev.key === " ") delete el.dataset.pressed;
          });
          el.addEventListener("blur", function () {
            // focus can leave with the key still held; never leave the pressed state stuck
            delete el.dataset.pressed;
          });
        });
      })();
    </script>
  </body>
</html>
