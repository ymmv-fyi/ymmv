---
// The profile page as a terminal session ("Transcript", decided 2026-08-24 from the /proto/profile
// prototype run — see DESIGN.md → Components & States): the command that produced the page sits on
// top, the stack is its output on one shared tab stop, and the next prompt line is the diff. No
// plate — the page IS the transcript. (The diff page followed on 2026-08-24 — "Session" — so no
// live document wears a plate any more; .sample remains the landing previews' frame.)
// All values are user-controlled: they render through UntrustedValue (Astro escaping + bidi-control
// stripping + safeHref scheme gate before any href); extras labels are bidi-stripped inline.
//
// `example`: when this is the landing-page sample (not the page's own profile), render the handle
// as a non-heading so it doesn't pollute the document outline / emit a 2nd <h1>, keep the typed
// command a plain line (no copy control inside the preview card), and omit the interactive foot.
import { KEY_LABELS, type Profile } from "@ymmv/shared";
import { sanitizeText } from "../lib/sanitize.ts";
import Arrow from "./Arrow.astro";
import InstallCommand from "./InstallCommand.astro";
import UntrustedValue from "./UntrustedValue.astro";

interface Props {
  profile: Profile;
  example?: boolean;
  /* more: landing preview only — the count of rows elided from the sample, rendered as an honest
     "+ N more" marker under the readout. Never set on a real profile page. */
  more?: number;
}
const { profile, example = false, more = 0 } = Astro.props;
const { handle, entries, extras, updated_at } = profile;
const hasStack = entries.length > 0;
const hasExtras = extras.length > 0;
// session revision stamp: date part only (the wire carries a full ISO timestamp)
const revDate = updated_at?.slice(0, 10);
---

<div class="session">
  {/* the command that produced this page — on live pages it is also the copy control */}
  <p class="cmdline">
    {example ? (
      <><span class="prompt">$ </span><b>npx ymmv-cli@latest {handle}</b></>
    ) : (
      <InstallCommand command={`npx ymmv-cli@latest ${handle}`} />
    )}
  </p>

  {/* the output opens with the page's address; the handle IS the h1, in the shell's own register */}
  {example ? (
    <p class="url">ymmv.fyi/<b>{handle}</b></p>
  ) : (
    <div class="url"><a href="/">ymmv.fyi</a>/<h1 class="handle">{handle}</h1></div>
  )}

  {/* one grid for stack + extras, so every value shares a single tab stop (like the CLI's padEnd);
      a blank line separates the groups — no group headers, transcripts don't have them */}
  {(hasStack || hasExtras) && (
    <div class="readout">
      {hasStack && (
        <dl class="rows">
          {entries.map((e) => (
            <div class="row">
              <dt>{KEY_LABELS[e.key]}</dt>
              <dd>
                <UntrustedValue value={e.value} />
              </dd>
            </div>
          ))}
        </dl>
      )}
      {hasStack && hasExtras && <div class="readout-gap" aria-hidden="true"></div>}
      {hasExtras && (
        <dl class="rows">
          {extras.map((x) => (
            <div class="row">
              <dt>{sanitizeText(x.label)}</dt>
              <dd>
                <UntrustedValue value={x.value} />
              </dd>
            </div>
          ))}
        </dl>
      )}
    </div>
  )}
  {example && more > 0 && <p class="spec-more">+ {more} more</p>}

  {!hasStack && !hasExtras && <p class="empty-msg">No stack published yet.</p>}

  {revDate && (
    <p class="rev">updated <time datetime={updated_at}>{revDate}</time></p>
  )}

  {!example && (
    <>
      <div class="foot term-foot">
        <p class="cmdline"><InstallCommand /><span class="cmt"># make yours</span></p>
        {/* action → the profile page, whose ?you= handler 302s to the diff: a native
            (script-failed) submit works from anywhere this form renders, including /vs/ nudges */}
        <form class="diff-cta" action={`/${handle}`} data-diff-vs={handle}>
          <label>
            <span class="prompt">$ </span>diff vs{" "}
            <input
              class="you"
              name="you"
              placeholder="<you>"
              maxlength="39"
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
              aria-label={`your handle — diff ${handle} against you`}
            />
          </label>
          <button class="go" type="submit" aria-label="view the diff"><Arrow size={18} /></button>
        </form>
      </div>
      <noscript>
        {/* is:inline — Astro must not hoist this out of the <noscript> gate */}
        <style is:inline>
          .diff-cta {
            display: none;
          }
        </style>
        <p class="cta">
          diff <Arrow /> <b>ymmv.fyi/{handle}/vs/&lt;you&gt;</b>
        </p>
      </noscript>
    </>
  )}
</div>
