---
// A copyable command: the landing's install CTA (tone "primary", the page's one white button), the
// profile's view command and the diff's compare command. Rendered as a plain <span> so with no JS /
// no Clipboard API it stays selectable text and never a dead control; the delegated [data-copy]
// inline script in Layout.astro promotes it to an ARIA button (role + tabindex + aria-label) and
// reveals the copy affordance only once wired (progressive enhancement). The trailing glyph morphs
// clipboard → check on success; the sr-only live region announces it.
interface Props {
  command?: string;
  /* primary: the white button, for the landing's install CTA. Default: the quiet dark command. */
  tone?: "primary";
  size?: "sm" | "lg";
}
// `@latest` and not the bare name: npx caches the bare spec and reuses it indefinitely, so a
// returning visitor would keep running whatever version their npx cache pinned months ago.
const { command = "npx ymmv-cli@latest", tone, size } = Astro.props;
---

<span
  class:list={["install", tone, size]}
  data-copy={command}
><span class="prompt">$ </span><span class="cmd">{command}</span><span class="copy-hint" aria-hidden="true"><span class="ch ch-idle"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="11" height="11" rx="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /></svg></span><span class="ch ch-done"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg></span></span><span class="sr-only" data-copy-status aria-live="polite"></span></span>
