---
// The landing's terminal pane: the real publish run (DESIGN.md → Landing). The transcript mirrors
// the CLI's actual output (packages/cli/src/render.ts + commands.ts — CLI parity: change the CLI's
// wording, update these lines). The accent marks what the CLI renders in its accent, the published
// link. Each line carries the moment it lands in the intro (--t).
//
// The intro (the command types itself, lines land in order) plays once per session and never under
// reduced motion; the finished transcript is the server markup, so no-JS and returning visitors see
// the whole run at once. Lines are built as one HTML string so no template whitespace leaks into the
// pre-wrap lines.
const esc = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;");
const line = (t: number, body: string) => `<span class="tl" style="--t:${t}ms">${body}</span>`;
const dim = (t: string) => `<span class="t-dim">${esc(t)}</span>`;
const CMD = "npx ymmv-cli@latest";
const TRANSCRIPT = [
  line(0, `<span class="t-p">$ </span><span class="type" style="--n:${CMD.length}">${CMD}</span>`),
  line(1000, ""),
  line(1150, `${dim("  Editor    ")}Neovim`),
  line(1250, `${dim("  Shell     ")}fish`),
  line(1350, `${dim("  Terminal  ")}Ghostty`),
  line(1450, dim("  …")),
  line(1500, ""),
  line(1900, `${dim("  Publish to ymmv.fyi/octocat? [Y/n/e=edit]")} y`),
  line(2400, ""),
  line(2600, `  Published octocat → <span class="t-link">ymmv.fyi/octocat</span>`),
].join("");
---

<div class="term" set:html={TRANSCRIPT} />

{/* is:inline, not a module: a module script waits for the whole document, so on a slow first
    load the finished run would paint, vanish, then replay. This runs as soon as it's parsed. */}
<script is:inline>
  // Once per session (sessionStorage, not localStorage: a genuinely new visit sees it again),
  // never under reduced motion. The section carries data-play; the stylesheet does the rest.
  var demo = document.querySelector("[data-demo]");
  if (demo && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    var KEY = "ymmv-landing-run";
    var seen = false;
    try {
      seen = sessionStorage.getItem(KEY) === "1";
      sessionStorage.setItem(KEY, "1");
    } catch (e) {}
    if (!seen) demo.setAttribute("data-play", "");
  }
</script>
